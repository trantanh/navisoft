<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorPane" minHeight="650.0" minWidth="1080.0" prefHeight="760.0" prefWidth="1320.0"
            styleClass="pos-shell" stylesheets="@../css/navipos.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.trantanh.navipos.view.cashdesk.CashDeskController">
    <children>
        <HBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox minWidth="620.0" spacing="14.0" styleClass="receipt-panel" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barcode-box">
                            <children>
                                <Label text="▥" styleClass="barcode-icon" />
                                <TextField fx:id="barcodeTextField" promptText="Naskenujte nebo zadejte čárový kód"
                                           styleClass="barcode-field" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="valueFVTextField" maxWidth="150.0" promptText="Cena"
                                           styleClass="inline-price-field" />
                                <Button mnemonicParsing="false" onAction="#showPriceProduct"
                                        styleClass="icon-action" text="⌕" />
                            </children>
                        </HBox>

                        <TableView fx:id="productTable" styleClass="receipt-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="indexColumn" maxWidth="54.0" minWidth="54.0" prefWidth="54.0" text="#" />
                                <TableColumn fx:id="nameColumn" minWidth="240.0" prefWidth="360.0" text="Položka" />
                                <TableColumn fx:id="quantityColumn" minWidth="130.0" prefWidth="150.0" text="Množství" />
                                <TableColumn fx:id="priceColumn" minWidth="130.0" prefWidth="160.0" text="Cena" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="receipt-footer">
                            <children>
                                <Button fx:id="button_open_cash" mnemonicParsing="false" onAction="#openCashDriver"
                                        styleClass="footer-action" text="＋  Otevřít pokladnu   F2" />
                                <Button fx:id="button_get_product_price" mnemonicParsing="false" onAction="#showPriceProduct"
                                        styleClass="footer-action" text="⌕  Zjistit cenu" />
                                <Button fx:id="button_edit_product" mnemonicParsing="false" onAction="#updateProduct"
                                        styleClass="footer-action" text="✎  Upravit zboží   F4" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox minWidth="410.0" prefWidth="500.0" spacing="14.0" HBox.hgrow="SOMETIMES">
                    <children>
                        <VBox spacing="12.0" styleClass="summary-card">
                            <padding>
                                <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Počet položek" styleClass="summary-caption" />
                                        <Label fx:id="itemsLabel" alignment="CENTER_RIGHT" text="0"
                                               styleClass="summary-count" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <HBox alignment="BASELINE_LEFT">
                                    <children>
                                        <Label text="K úhradě" styleClass="amount-title" />
                                        <Label fx:id="totalPriceLabel" alignment="CENTER_RIGHT" text="0.00"
                                               styleClass="totalprice-label" HBox.hgrow="ALWAYS" />
                                        <Label text=" Kč" styleClass="amount-currency" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="payment-row">
                                    <children>
                                        <Label fx:id="payLabel" minWidth="105.0" text="Zaplaceno" styleClass="summary-caption" />
                                        <TextField fx:id="payTextField" alignment="CENTER_RIGHT" promptText="0,00"
                                                   styleClass="pay-text-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="getMoneyLabel" text="Vrátit" styleClass="summary-caption" />
                                        <Label fx:id="returnMoneyLabel" alignment="CENTER_RIGHT" text="0.00"
                                               styleClass="return-amount" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="currencyLabel" text=" Kč" styleClass="return-currency" />
                                    </children>
                                </HBox>
                                <Button mnemonicParsing="false" onAction="#startPayment" maxWidth="1.7976931348623157E308"
                                        styleClass="pay-button" text="▣   ZAPLATIT                         ENTER" />
                            </children>
                        </VBox>

                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="76.0" prefHeight="82.0" />
                                <RowConstraints minHeight="64.0" prefHeight="70.0" />
                            </rowConstraints>
                            <children>
                                <Button fx:id="payCardButton" mnemonicParsing="false" onAction="#payCard"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="quick-action" text="▰&#10;Platba kartou" />
                                <Button fx:id="button_storno" mnemonicParsing="false" onAction="#stornoProduct"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="quick-action,danger-action" text="⊘&#10;Storno   F3" GridPane.columnIndex="1" />
                                <Button fx:id="button_bill" mnemonicParsing="false" onAction="#bill"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="quick-action" text="▤&#10;Účtenky   F5" GridPane.columnIndex="2" />
                                <Button mnemonicParsing="false" onAction="#goToPriceTags"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="quick-action" text="◇&#10;Cenovky" GridPane.columnIndex="3" />
                                <Button fx:id="printerButton" mnemonicParsing="false" onAction="#printerButton"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="status-action" text="Tiskárna vypnuta" GridPane.rowIndex="1" GridPane.columnSpan="2" />
                                <Button fx:id="redundanceButton" mnemonicParsing="false" onAction="#redundance"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="secondary-action" text="↩  Refundace" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Button fx:id="button_return_product" mnemonicParsing="false" onAction="#returnProduct"
                                        maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
                                        styleClass="secondary-action" text="Vrátit zboží" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <Label text="OBLÍBENÉ POLOŽKY" styleClass="section-eyebrow" />
                        <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints percentHeight="50.0" minHeight="82.0" />
                                <RowConstraints percentHeight="50.0" minHeight="82.0" />
                            </rowConstraints>
                            <children>
                                <Button fx:id="productButton" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Pečivo" />
                                <Button fx:id="productButton2" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Potraviny" GridPane.columnIndex="1" />
                                <Button fx:id="productButton3" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Nápoje" GridPane.columnIndex="2" />
                                <Button fx:id="productButton4" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Ovoce a zelenina" GridPane.columnIndex="3" />
                                <Button fx:id="productButton5" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Drogerie" GridPane.rowIndex="1" />
                                <Button fx:id="productButton6" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Vratné obaly" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Button fx:id="productButton7" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Tabák" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Button fx:id="productButton8" mnemonicParsing="false" maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308" styleClass="favorite-button" text="Další" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                        <Label fx:id="flashMessage" maxWidth="1.7976931348623157E308" styleClass="flash-message" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>

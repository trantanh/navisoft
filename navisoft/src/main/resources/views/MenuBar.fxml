<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane id="AnchorPane" prefHeight="80.0" prefWidth="1320.0" styleClass="background" stylesheets="@../css/navipos.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.trantanh.navipos.MenuBarController">
   <children>
      <HBox alignment="CENTER" prefHeight="65.0" prefWidth="1200.0" stylesheets="@../css/navipos.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button fx:id="cashDeskButton" mnemonicParsing="false" onAction="#goToCaskDesk" prefHeight="54.0" prefWidth="171.0" styleClass="cashdesk-button" text="Pokladna" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="10.0" left="15.0" right="30.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="statisticsButton" mnemonicParsing="false" onAction="#goToStatistic" prefHeight="54.0" prefWidth="197.0" styleClass="statistic-button" text="Tržby" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="10.0" right="30.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="storeButton" mnemonicParsing="false" onAction="#goToStore" prefHeight="52.0" prefWidth="197.0" styleClass="store-button" text="Sklad" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="10.0" right="30.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="settingButton" mnemonicParsing="false" onAction="#goToSetting" prefHeight="50.0" prefWidth="199.0" styleClass="setting-button" text="Nastaveni" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
